# Copy to .env and fill in. Never commit the real .env.

# SQLite for a single-server deployment. For Postgres, also change the
# provider in prisma/schema.prisma and the adapter in src/lib/prisma.ts.
DATABASE_URL="file:./dev.db"

# Signs the admin session cookie. Anyone who knows it can forge an admin
# session. In production the app refuses to start if this is shorter than
# 32 characters or is left at a placeholder like "change-me".
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me"

# Only read by `prisma db seed` when creating the first admin account. The
# seeded account is flagged to force a password change on first sign-in, and
# seeding refuses the default password entirely when NODE_ENV=production.
SEED_ADMIN_EMAIL="admin@elwahapumps.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# Set to 1 to let `prisma db seed` overwrite existing product rows from the
# src/data/products.ts fixture. Off by default so re-seeding cannot destroy
# edits made through the admin.
SEED_OVERWRITE_PRODUCTS=

# Optional — emails a human when a lead or cart inquiry comes in (lib/notify.ts).
# Without these, leads still save to the database; only the notification is
# skipped, with a warning in the server log.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# SMTP_FROM="" # defaults to SMTP_USER
# LEAD_NOTIFY_TO="" # defaults to lib/company.ts's EMAIL
