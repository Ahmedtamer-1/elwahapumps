# Copy to .env and fill in. Never commit the real .env.

# SQLite for a single-server deployment. For Postgres, also change the
# provider in prisma/schema.prisma and the adapter in src/lib/prisma.ts.
DATABASE_URL="file:./dev.db"

# Signs the admin session cookie. MUST be long and random in production —
# anyone who knows it can forge an admin session.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me"

# Where cart requests are sent, international format without the +
WHATSAPP_PHONE="201066685532"

# Only read by `prisma db seed` when creating the first admin account.
SEED_ADMIN_EMAIL="admin@elwahapumps.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# Optional — emails a human when a lead or cart inquiry comes in (lib/notify.ts).
# Without these, leads still save to the database; only the notification is
# skipped, with a warning in the server log.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# SMTP_FROM="" # defaults to SMTP_USER
# LEAD_NOTIFY_TO="" # defaults to lib/company.ts's EMAIL
